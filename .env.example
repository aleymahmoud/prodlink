# ----------------------------------------------------------------------------
# NextAuth (REQUIRED)
# ----------------------------------------------------------------------------
# Secret used to sign/encrypt JWT session tokens. NextAuth v5 will reject
# every login with a generic "Configuration" error if this is not set in
# production. Generate one with: `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-string

# Public base URL of the deployed app (e.g. https://prodlink.example.com).
# Required when running behind a proxy or on a non-standard host.
# AUTH_URL=https://your-domain.example.com

# ----------------------------------------------------------------------------
# Database (REQUIRED)
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname

# ----------------------------------------------------------------------------
# Default admin bootstrapped by scripts/db-setup.js
# ----------------------------------------------------------------------------
# ADMIN_EMAIL=admin@prodlink.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# ADMIN_NAME=System Admin

# ----------------------------------------------------------------------------
# Supabase (optional - legacy)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
